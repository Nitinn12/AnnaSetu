# Copy this file to .env and adjust the values.

# Secret used to sign sessions and CSRF tokens. Use a long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Database connection string. Leave empty to use instance/annasetu.db (SQLite).
DATABASE_URL=

# Optional Gemini API key. Not used in Phase 1; leave empty.
GEMINI_API_KEY=

# Debug mode: 1 = on (development only), 0 = off.
FLASK_DEBUG=1

# Production: set a long random SECRET_KEY (required unless FLASK_DEBUG=1)
# PORT=5000
# HOST=127.0.0.1
# Set to 1 when the site is served over HTTPS
# SESSION_COOKIE_SECURE=0
# PostgreSQL example (install psycopg first): postgresql://USER:PASSWORD@HOST:5432/annasetu
